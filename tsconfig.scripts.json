{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".prediction-cli",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*.ts",
    "src/features/prediction-data/**/*.ts",
    "src/features/shared/variety-category.ts"
  ],
  "exclude": ["**/*.test.ts"]
}
