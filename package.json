{
  "name": "teiki-chosa-output",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prediction:masters:build": "tsc -p tsconfig.scripts.json",
    "prediction:masters:summary": "npm run prediction:masters:build && node --env-file=.env.prediction.local .prediction-cli/scripts/generate-prediction-masters.js summary",
    "prediction:masters:dry-run": "npm run prediction:masters:build && node --env-file=.env.prediction.local .prediction-cli/scripts/generate-prediction-masters.js dry-run",
    "prediction:masters:write:dry-run": "npm run prediction:masters:build && node --env-file=.env.prediction.local .prediction-cli/scripts/write-prediction-masters.js dry-run",
    "prediction:masters:write": "npm run prediction:masters:build && node --env-file=.env.prediction.local .prediction-cli/scripts/write-prediction-masters.js write",
    "prediction:mvp:verify": "npm run prediction:masters:build && node --env-file=.env.prediction.local .prediction-cli/scripts/verify-prediction-mvp.js"
  },
  "dependencies": {
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
